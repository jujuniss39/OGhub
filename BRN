local function SendWebhook(content)
    if not webhookEnabled or webhookURL == "" then return end
    pcall(function()
        request({
            Url = webhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = game:GetService("HttpService"):JSONEncode({
                content = content,
                allowed_mentions = {parse = {}}
            })
        })
    end)
end

local notifiedCache = {}
Player.Backpack.ChildAdded:Connect(function(tool)
    if not webhookEnabled then return end
    if notifiedCache[tool] then return end
    notifiedCache[tool] = true
    task.delay(5, function() notifiedCache[tool] = nil end)
    
    local filter = Options.WebhookFilter.Value
    local mutation = tool:GetAttribute("Mutation")
    local brainrotType = tool:GetAttribute("BrainrotType")
    
    if filter["Mutation"] and mutation and Options.WebhookMutations.Value[mutation:upper()] then
        SendWebhook(string.format("🎯 **Mutation Found!**\nTool: `%s`\nMutation: `%s`", tool.Name, mutation))
    end
    
    if filter["Name"] and brainrotType and Options.WebhookNames.Value[brainrotType] then
        SendWebhook(string.format("🔔 **Name Found!**\nTool: `%s`\nType: `%s`", tool.Name, brainrotType))
    end
end)

