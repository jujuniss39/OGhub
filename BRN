local function runQuests()
    pcall(function()
        local playerGui = Player.PlayerGui
        local windows = playerGui:FindFirstChild("Windows")
        if not windows then return end
        local event = windows:FindFirstChild("Event")
        if not event then return end
        local frame = event:FindFirstChild("Frame")
        if not frame then return end
        local windows2 = frame:FindFirstChild("Windows")
        if not windows2 then return end
        local quests = windows2:FindFirstChild("Quests")
        if not quests then return end
        local questFrame = quests:FindFirstChild("Frame")
        if not questFrame then return end
        local scrollingFrame = questFrame:FindFirstChild("ScrollingFrame")
        if not scrollingFrame then return end
        
        local function claim(frameToCheck)
            if not frameToCheck then return end
            for _, child in ipairs(frameToCheck:GetChildren()) do
                local claimed = child:FindFirstChild("Claimed")
                local claimBtn = child:FindFirstChild("Claim")
                if claimed and not claimed.Visible and claimBtn then
                    pcall(function() claimBtn:Activate() end)
                    task.wait(0.3)
                end
            end
        end
        
        local daily = scrollingFrame:FindFirstChild("DailyQuests")
        local hourly = scrollingFrame:FindFirstChild("HourlyQuests")
        
        if daily then
            local dailyFrame = daily:FindFirstChild("Frame")
            if dailyFrame then
                local frameInner = dailyFrame:FindFirstChild("Frame")
                if frameInner then claim(frameInner:FindFirstChild("Frame")) end
            end
        end
        if hourly then
            local hourlyFrame = hourly:FindFirstChild("Frame")
            if hourlyFrame then
                local frameInner = hourlyFrame:FindFirstChild("Frame")
                if frameInner then claim(frameInner:FindFirstChild("Frame")) end
            end
        end
    end)
end

