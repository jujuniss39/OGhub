                local claimed = child:FindFirstChild("Claimed")
                local claimBtn = child:FindFirstChild("Claim")
                if claimed and not claimed.Visible and claimBtn then
                    pcall(function() claimBtn:Activate() end)
                    task.wait(0.3)
                end
            end
        end
        
        local daily = frame:FindFirstChild("DailyQuests")
        local hourly = frame:FindFirstChild("HourlyQuests")
        if daily then claim(daily.Frame.Frame.Frame) end
        if hourly then claim(hourly.Frame.Frame.Frame) end
    end
    questRunning = false
end

Tabs.Farm:AddToggle("QuestToggle", {
    Title = "Auto Complete BP Quests",
    Default = false
}):OnChanged(function(state)
    if state and not questRunning then
        task.spawn(function()
            while Options.QuestToggle.Value do
                runQuests()
                task.wait(5)
            end
        end)
    end
end)

