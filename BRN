local mutationToggles = {}

local mutations = {"ALL", "NORMAL", "CANDY", "GOLD", "DIAMOND", "VOID"}

for _, mut in ipairs(mutations) do
    local tog = MutationFilterSection:AddToggle({
        Title = mut,
        Default = (mut == "ALL"),
        Callback = function(state)
            if state then
                giveMutationFilter = mut
                for _, t in pairs(mutationToggles) do
                    if t ~= tog then pcall(function() t:SetValue(false) end) end
                end
                UpdateMonitor()
            end
        end
    })
    mutationToggles[mut] = tog
end

-- SCAN INVENTORY
local ScanSection = GiveTab:AddSection("🔍 SCAN INVENTORY", true)
local ScanStatus = ScanSection:AddParagraph({Title = "STATUS", Content = "Click SCAN to find brainrot names"})

local function GetBrainrotDisplayName(tool)
    local brainrotType = tool:GetAttribute("BrainrotType")
    if brainrotType and brainrotType ~= "" then
        return brainrotType
    end
    
    local displayName = tool:GetAttribute("DisplayName")
    if displayName and displayName ~= "" then
        return displayName
    end
    
    local originalName = tool:GetAttribute("OriginalName")
    if originalName and originalName ~= "" then
        return originalName
    end
    
    local toolName = tool.Name
    if toolName:match("void_") or toolName:match("%d+") then
        for _, child in ipairs(tool:GetChildren()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                local text = child.Text
                if text and text ~= "" and not text:match("void_") then
                    return text
                end
            end
        end
        return "Unknown Brainrot"
    end
    
    return toolName
end

local function ScanUniqueBrainrotNames()
    local names = {}
    
    local function scanContainer(container)
        if not container then return end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local displayName = GetBrainrotDisplayName(tool)
                if displayName and displayName ~= "" and not names[displayName] then
                    names[displayName] = true
                end
            end
        end
    end
    
    scanContainer(Player:FindFirstChild("Backpack"))
    scanContainer(Player.Character)
    
    local nameList = {}
    for name in pairs(names) do
        table.insert(nameList, name)
    end
    table.sort(nameList)
    
    return nameList
end

-- SELECT BRAINROT NAME
local NameSection = GiveTab:AddSection("📛 SELECT BRAINROT NAME", true)
local NameContent = NameSection:AddParagraph({Title = "AVAILABLE NAMES", Content = "Click SCAN first"})

local function RefreshNameUI()
    for _, tog in pairs(nameFilterToggles) do
        pcall(function() tog:Destroy() end)
    end
    nameFilterToggles = {}
    
    local allTog = NameSection:AddToggle({
        Title = "ALL NAMES",
        Default = (selectedBrainrotName == "ALL"),
        Callback = function(state)
            if state then
                selectedBrainrotName = "ALL"
                for _, t in pairs(nameFilterToggles) do
                    if t ~= allTog then pcall(function() t:SetValue(false) end) end
                end
                UpdateMonitor()
            end
        end
    })
    nameFilterToggles["ALL"] = allTog
    
    for _, name in ipairs(uniqueNames) do
        local displayName = string.sub(name, 1, 28)
        local tog = NameSection:AddToggle({
            Title = displayName,
            Default = (selectedBrainrotName == name),
            Callback = function(state)
                if state then
                    selectedBrainrotName = name
                    for _, t in pairs(nameFilterToggles) do
                        if t ~= tog then pcall(function() t:SetValue(false) end) end
                    end
                    UpdateMonitor()
                end
            end
        })
        nameFilterToggles[name] = tog
    end
    
    if #uniqueNames > 0 then
        local nameListStr = "📋 Found:\n" .. table.concat(uniqueNames, "\n")
        NameContent:SetContent(nameListStr)
    else
        NameContent:SetContent("No brainrots found in inventory")
    end
end

ScanSection:AddButton({
    Title = "🔍 SCAN INVENTORY",
    Callback = function()
        ScanStatus:SetContent("Scanning...")
        task.wait(0.3)
        
        uniqueNames = ScanUniqueBrainrotNames()
        
        if #uniqueNames > 0 then
            ScanStatus:SetContent(string.format("✅ Found %d unique names", #uniqueNames))
            RefreshNameUI()
        else
            ScanStatus:SetContent("❌ No brainrots found")
            NameContent:SetContent("No brainrots in inventory")
        end
        
        UpdateMonitor()
    end
})

-- GET FILTERED BRAINROTS
local function GetMyBrainrots()
    local brainrots = {}
    
    local function scanContainer(container)
        if not container then return end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local mutation = tool:GetAttribute("Mutation") or "NORMAL"
                local entityId = tool:GetAttribute("EntityId")
                local displayName = GetBrainrotDisplayName(tool)
                
                table.insert(brainrots, {
                    Name = displayName,
                    RawName = tool.Name,
                    Mutation = string.upper(mutation),
                    EntityId = entityId,
                    Tool = tool
                })
            end
        end
    end
    
    scanContainer(Player:FindFirstChild("Backpack"))
    scanContainer(Player.Character)
    
    return brainrots
end

local function GetAndSelectBrainrots()
    local all = GetMyBrainrots()
    local filtered = {}
    
    for _, br in ipairs(all) do
        local mutationMatch = (giveMutationFilter == "ALL" or br.Mutation == giveMutationFilter)
        local nameMatch = (selectedBrainrotName == "ALL" or br.Name == selectedBrainrotName)
        
        if mutationMatch and nameMatch then
            table.insert(filtered, br)
        end
    end
    
    return filtered
end

