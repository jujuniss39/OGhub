local QuantitySection = GiveTab:AddSection("🔢 QUANTITY TO SEND", true)

QuantitySection:AddInput({
    Title = "Number of brainrots",
    Default = "1",
    Placeholder = "Number or 'all'",
    Callback = function(value)
        if string.lower(value) == "all" then
            giveQuantity = "all"
        else
