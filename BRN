local function FindRemote(paths)
    for _, path in ipairs(paths) do
        local current = ReplicatedStorage
        local found = true
        for _, part in ipairs(path) do
            current = current:FindFirstChild(part)
            if not current then
                found = false
                break
            end
        end
        if found and current then
            return current
        end
    end
    return nil
end

