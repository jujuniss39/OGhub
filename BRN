local eventThread

EventSection:AddDivider()
EventSection:AddToggle({
    Title = "AUTO CLAIM EVENT PASS REWARDS",
    Default = false,
    Callback = function(state)
        autoEventRunning = state
        if state then
            EventStatus:SetContent("ON")
            eventThread = task.spawn(function()
                while autoEventRunning do
                    pcall(function()
                        local playerGui = Player.PlayerGui
                        local windows = playerGui:FindFirstChild("Windows")
                        if windows then
                            local event = windows:FindFirstChild("Event")
                            if event then
                                local frame = event:FindFirstChild("Frame")
                                if frame then
                                    local windows2 = frame:FindFirstChild("Windows")
                                    if windows2 then
                                        local pass = windows2:FindFirstChild("Pass")
                                        if pass then
                                            local main = pass:FindFirstChild("Main")
                                            if main then
                                                local scrollingFrame = main:FindFirstChild("ScrollingFrame")
                                                if scrollingFrame then
                                                    for i = 1, 10 do
                                                        if not autoEventRunning then break end
                                                        local item = scrollingFrame:FindFirstChild(tostring(i))
                                                        if item and item:FindFirstChild("Frame") and item.Frame:FindFirstChild("Free") then
                                                            local free = item.Frame.Free
                                                            local locked = free:FindFirstChild("Locked")
                                                            if locked and not locked.Visible and claimPass then
