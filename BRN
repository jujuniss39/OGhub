            giveQuantity = (num and num > 0) and num or 1
        end
        UpdateMonitor()
    end
})

-- SEND
local SendSection = GiveTab:AddSection("🚀 SEND GIFT", true)
local SendStatus = SendSection:AddParagraph({Title = "STATUS", Content = "Ready"})

SendSection:AddButton({
    Title = "💝 GIVE SELECTED TO TARGET",
    Callback = function()
        if not selectedTarget then
            SendStatus:SetContent("❌ No target selected")
            return
        end
        
        local toGive = {}
        for _, br in pairs(selectedBrainrots) do
            table.insert(toGive, br)
        end
        
        if #toGive == 0 then
            SendStatus:SetContent("❌ No brainrot selected. Click SELECT ALL first!")
            return
        end
        
        local qty = giveQuantity
        if qty == "all" or qty > #toGive then
            qty = #toGive
        end
        
        SendStatus:SetContent(string.format("📤 Sending %d to %s...", qty, selectedTarget.Name))
        
        local successCount = 0
        for i = 1, qty do
            local br = toGive[i]
            if br.Tool and br.Tool.Parent and DirectGiftToPlayer(selectedTarget, br) then
                successCount = successCount + 1
                selectedBrainrots[br.EntityId] = nil
            end
            task.wait(0.3)
        end
        
        SendStatus:SetContent(string.format("✅ Sent %d brainrot(s)", successCount))
        UpdateMonitor()
        
        if successCount > 0 then
            print("Gift sent to", selectedTarget.Name)
        end
    end
})

